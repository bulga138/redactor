{
  "name": "@bulga138/redactor",
  "version": "0.5.1",
  "description": "Keeps credentials out of your model's context — OpenCode V2 plugin",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --external @opencode/plugin",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "security",
    "redaction",
    "secrets"
  ],
  "author": "bulga138",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulga138/redactor.git"
  },
  "homepage": "https://github.com/bulga138/redactor#readme",
  "bugs": {
    "url": "https://github.com/bulga138/redactor/issues"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.2"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "bun-types": "1.3.13",
    "typescript": "5.9.3"
  }
}
